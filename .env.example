# Nach .env.local kopieren und mit den Werten aus dem Supabase-Projekt füllen
# (Project Settings, API). .env.local wird nie eingecheckt.
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=dein-publishable-key

# Anmeldung über Drittanbieter. Nur eintragen, was im Supabase-Projekt unter
# Authentication, Providers aktiviert ist. Leer lassen für reine E-Mail-Anmeldung.
# Möglich: apple, google, facebook
NEXT_PUBLIC_AUTH_PROVIDERS=google

# Anmeldung per Passkey (Face ID, Fingerabdruck). Nur auf true setzen, wenn Passkeys im
# Supabase-Projekt unter Authentication, Passkeys aktiviert sind.
NEXT_PUBLIC_PASSKEYS=false
